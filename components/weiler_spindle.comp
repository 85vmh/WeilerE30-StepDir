component weiler_spindle "Chuck cover safety for the spindle in manual/MDI mode";

/* ===== Inputs ===== */
pin in  bit   machineOn            "halui.machine.is-on (machine-is-on)";
pin in  bit   spindleOn            "halui.spindle.0.is-on (sp.is-running)";
pin in  bit   spindleNeutral       "in.spindle-neutral";
pin in  bit   spindleCoverOpened   "in.chuck-cover (1 = open)";
pin in  bit   isAutoMode           "halui.mode.is-auto (in.is-auto-mode)";

pin in  float outputPulseDuration = 0.10  "Seconds; length of the spindleStop pulse";

/* ===== Outputs ===== */
pin out bit   spindleInhibit               "-> or.sp-inhibit.in1 (latched)";
pin out bit   spindleStop                  "-> halui.spindle.0.stop (pulse)";
pin out bit   statusSpindleResetRequired   "Latched: selector to neutral + cover closed to clear";

function _ "Run the chuck cover safety logic";
license "GPLv2";
author  "vasi";

description """
Replaces the *Spindle* section of the ClassicLadder program.

Opening the chuck cover while the spindle is running in manual or MDI mode
latches *spindleInhibit* and *statusSpindleResetRequired*. Both stay latched
until the operator brings the spindle selector back to neutral **and** closes
the cover - closing the cover alone is not enough, which is what forces the
selector out of the running position before the spindle can start again.

Returning the selector to neutral with the machine on, in manual or MDI, also
pulses *spindleStop* so the running command is actually cancelled.

AUTO mode is deliberately excluded: there the chuck cover is handled by the
overlay in *program_state*, whose *spindleInhibit* is OR'd with this one in HAL.

The latches survive a machine off/on cycle, as they did in the ladder.

[source,hal]
----
loadrt weiler_spindle
addf weiler-spindle.0 servo-thread
setp weiler-spindle.0.outputPulseDuration 0.10
net in.chuck-cover =>  weiler-spindle.0.spindleCoverOpened
net ldr.sInhibit   weiler-spindle.0.spindleInhibit => or.sp-inhibit.in1
net out.sp-stop    weiler-spindle.0.spindleStop    => halui.spindle.0.stop
----
""";

;;
#include <stdbool.h>
#include "rtapi.h"
#include "hal.h"

/* ===== Edge detector on the stop condition ===== */
static int last_stop_cond = 0;

/* ===== Pulse timer (seconds) ===== */
static double t_stop = 0.0;

/* Helper: start a timed pulse on a HAL bit pin */
static inline void pulse_output_pin(double *timer_ref, hal_bit_t *pin_ref, float duration_sec)
{
    double d = (double)duration_sec;
    if (d < 0.01) d = 0.01;
    if (d > 5.00) d = 5.00;
    *timer_ref = d;
    *pin_ref   = 1;
}

FUNCTION(_)
{
    int stop_cond;

    /* ===== Cover opened with the spindle running, in manual/MDI: latch ===== */
    if (spindleCoverOpened && spindleOn && !isAutoMode) {
        spindleInhibit             = 1;
        statusSpindleResetRequired = 1;
    }

    /* ===== Selector back to neutral with the cover closed: clear the latch =====
       Mutually exclusive with the block above, so the order does not matter -
       same as the SET and RESET coils in the ladder. */
    if (spindleNeutral && !spindleCoverOpened) {
        statusSpindleResetRequired = 0;
        spindleInhibit             = 0;
    }

    /* ===== Selector to neutral with the machine on, in manual/MDI: stop pulse ===== */
    stop_cond = (spindleNeutral && machineOn && !isAutoMode) ? 1 : 0;

    if (stop_cond && !last_stop_cond)
        pulse_output_pin(&t_stop, &spindleStop, outputPulseDuration);

    last_stop_cond = stop_cond;

    /* ===== Pulse timer ===== */
    if (t_stop > 0.0) {
        t_stop -= fperiod;
        if (t_stop <= 0.0) { t_stop = 0.0; spindleStop = 0; }
    }
}
