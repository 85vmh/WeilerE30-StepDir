component weiler_homing "Sequential joystick-driven homing for the Weiler lathe: X first, then Z";

/* ===== Inputs ===== */
pin in  bit   machine-on    "Machine is powered on (machine-is-on)";
pin in  bit   joystick-x    "Hold to home X (in.joystick-x-plus)";
pin in  bit   joystick-z    "Hold to home Z (in.joystick-z-plus)";
pin in  bit   x-homed       "halui.joint.0.is-homed";
pin in  bit   z-homed       "halui.joint.1.is-homed";

pin in  float abort-pulse-duration      = 0.10  "Seconds; length of the abort-homing pulse";
pin in  float axes-homed-pulse-duration = 0.10  "Seconds; length of the axes-homed pulse";

/* ===== Outputs ===== */
pin out bit   home-x        "-> halui.joint.0.home (level, held while homing X)";
pin out bit   home-z        "-> halui.joint.1.home (level, held while homing Z)";
pin out bit   abort-homing  "-> halui.abort (pulse) when the joystick is released mid-homing";
pin out bit   axes-homed    "Pulse once both axes are homed";

/* ===== Debug ===== */
param rw s32  state_dbg;    /* 0=IDLE, 1=WAIT_X, 2=HOMING_X, 3=WAIT_Z, 4=HOMING_Z, 5=DONE */

function _ "Run the homing state machine";
license "GPLv2";
author  "vasi";

description """
Replaces the *Homing* rungs of the ClassicLadder program. The operator homes X
by holding the joystick towards X plus, then Z by holding it towards Z plus;
the order is enforced, Z cannot start before *x-homed*.

Releasing the joystick before the axis reports homed pulses *abort-homing*
(wired to *halui.abort*), which cancels the home move; a fresh rising edge on
the joystick pin restarts it. A rising edge is required, so homing never starts
by itself when the joystick happens to be held at machine on, or right after an
abort.

*axes-homed* pulses on every false->true transition of *x-homed AND z-homed*
while the machine is on, including the case where the machine is turned on with
both axes already homed.

Turning the machine off resets the state machine silently, without an abort
pulse: LinuxCNC drops the motion anyway.

[source,hal]
----
loadrt weiler_homing
addf weiler-homing.0 servo-thread
setp weiler-homing.0.abort-pulse-duration 0.10
net machine-is-on      => weiler-homing.0.machine-on
net in.joystick-x-plus => weiler-homing.0.joystick-x
net out.home-x weiler-homing.0.home-x => halui.joint.0.home
----
""";

;;
#include <stdbool.h>
#include "rtapi.h"
#include "hal.h"

/* ===== States ===== */
enum {
    ST_IDLE     = 0,    /* machine off */
    ST_WAIT_X   = 1,    /* waiting for a rising edge on joystick-x */
    ST_HOMING_X = 2,    /* home-x asserted */
    ST_WAIT_Z   = 3,    /* X done, waiting for a rising edge on joystick-z */
    ST_HOMING_Z = 4,    /* home-z asserted */
    ST_DONE     = 5     /* both axes homed */
};

static int state = ST_IDLE;

/* ===== Edge detectors ===== */
static int last_joystick_x = 0;
static int last_joystick_z = 0;
static int last_both_homed = 0;

/* ===== Pulse timers (seconds) ===== */
static double t_abort      = 0.0;
static double t_axes_homed = 0.0;

/* Helper: start a timed pulse on a HAL bit pin */
static inline void pulse_output_pin(double *timer_ref, hal_bit_t *pin_ref, float duration_sec)
{
    double d = (double)duration_sec;
    if (d < 0.01) d = 0.01;
    if (d > 5.00) d = 5.00;
    *timer_ref = d;
    *pin_ref   = 1;
}

FUNCTION(_)
{
    const int machine_on_now = machine_on ? 1 : 0;
    const int both_homed     = (x_homed && z_homed) ? 1 : 0;

    /* rising edges on the joystick pins */
    const int joy_x_rise = (joystick_x && !last_joystick_x) ? 1 : 0;
    const int joy_z_rise = (joystick_z && !last_joystick_z) ? 1 : 0;

    if (!machine_on_now) {
        /* machine off: silent reset, no abort pulse */
        state           = ST_IDLE;
        home_x          = 0;
        home_z          = 0;
        last_both_homed = 0;    /* so turning back on re-pulses axes-homed */
        goto _timers;
    }

    /* leaving ST_IDLE: pick up wherever the axes already are */
    if (state == ST_IDLE)
        state = ST_WAIT_X;

    /* re-derive the phase from the homed flags, so an unhome from the UI
       drops the state machine back to the matching wait state */
    switch (state) {
    case ST_WAIT_X:
    case ST_WAIT_Z:
    case ST_DONE:
        if      (!x_homed)  state = ST_WAIT_X;
        else if (!z_homed)  state = ST_WAIT_Z;
        else                state = ST_DONE;
        break;
    default:
        break;
    }

    switch (state) {
    case ST_WAIT_X:
        home_x = 0;
        home_z = 0;
        if (joy_x_rise) {
            state  = ST_HOMING_X;
            home_x = 1;
        }
        break;

    case ST_HOMING_X:
        if (x_homed) {
            home_x = 0;
            state  = ST_WAIT_Z;
        } else if (!joystick_x) {
            /* released before the axis was homed -> cancel the home move */
            home_x = 0;
            pulse_output_pin(&t_abort, &abort_homing, abort_pulse_duration);
            state = ST_WAIT_X;
        } else {
            home_x = 1;
        }
        break;

    case ST_WAIT_Z:
        home_x = 0;
        home_z = 0;
        if (joy_z_rise) {
            state  = ST_HOMING_Z;
            home_z = 1;
        }
        break;

    case ST_HOMING_Z:
        if (z_homed) {
            home_z = 0;
            state  = ST_DONE;
        } else if (!joystick_z) {
            home_z = 0;
            pulse_output_pin(&t_abort, &abort_homing, abort_pulse_duration);
            state = ST_WAIT_Z;
        } else {
            home_z = 1;
        }
        break;

    case ST_DONE:
    default:
        home_x = 0;
        home_z = 0;
        break;
    }

    /* both axes homed: independent of the state machine, so it also fires when
       the machine comes on with the axes already homed */
    if (both_homed && !last_both_homed)
        pulse_output_pin(&t_axes_homed, &axes_homed, axes_homed_pulse_duration);
    last_both_homed = both_homed;

_timers:
    /* ===== Pulse timers ===== */
    if (t_abort > 0.0) {
        t_abort -= fperiod;
        if (t_abort <= 0.0) { t_abort = 0.0; abort_homing = 0; }
    }
    if (t_axes_homed > 0.0) {
        t_axes_homed -= fperiod;
        if (t_axes_homed <= 0.0) { t_axes_homed = 0.0; axes_homed = 0; }
    }

    /* remember edges */
    last_joystick_x = joystick_x ? 1 : 0;
    last_joystick_z = joystick_z ? 1 : 0;

    state_dbg = state;
}
