component weiler_startup "Power-on interlock and machine on/off pulses for the Weiler lathe";

/* ===== Inputs ===== */
pin in  bit   machine-on        "halui.machine.is-on (machine-is-on)";
pin in  bit   powered-on        "Contactor / drives-enabled feedback (in.enable-drives)";
pin in  bit   joystick-neutral  "in.joystick-neutral";
pin in  bit   spindle-neutral   "in.spindle-neutral";

pin in  s32   powered-on-debounce   = 5    "Debounce for powered-on, in thread samples (like debounce.N.delay)";
pin in  float output-pulse-duration = 0.10 "Seconds; length of the turn-on / turn-off pulses";

/* ===== Outputs ===== */
pin out bit   nc-ready   "-> out.nc-ready (SSR): power-on interlock, held while the machine is on";
pin out bit   turn-on    "-> halui.machine.on  (pulse)";
pin out bit   turn-off   "-> halui.machine.off (pulse)";

/* ===== Debug ===== */
param rw bit  powered_on_dbg;   /* debounced powered-on, for troubleshooting */

function _ "Run the startup interlock and on/off pulses";
license "GPLv2";
author  "vasi";

description """
Replaces the *OnOff* section of the ClassicLadder program.

*nc-ready* is the power-on interlock: the machine may only be energised with the
joystick and the spindle selector on neutral. It is recomputed only while the
machine is off and then holds its value, which is what the ladder's SET/RESET
coil pair did.

*turn-on* pulses when the contactor feedback comes up while the machine is off,
after *powered-on* has been stable for *powered-on-debounce* thread invocations,
and only if the interlock allows it. *turn-off* pulses on the falling edge of the
raw *powered-on* input: the off path is deliberately unfiltered, so stopping is
never delayed.

[source,hal]
----
loadrt weiler_startup
addf weiler-startup.0 servo-thread
setp weiler-startup.0.powered-on-debounce   30
setp weiler-startup.0.output-pulse-duration 0.10
net in.enable-drives => weiler-startup.0.powered-on
net out.machine-on   weiler-startup.0.turn-on => halui.machine.on
----
""";

;;
#include <stdbool.h>
#include "rtapi.h"
#include "hal.h"

/* ===== Debounce state ===== */
static int db_count      = 0;
static int powered_on_db = 0;

/* ===== Edge detectors on the pulse conditions ===== */
static int last_on_cond  = 0;
static int last_off_cond = 0;

/* ===== Pulse timers (seconds) ===== */
static double t_on  = 0.0;
static double t_off = 0.0;

/* Helper: start a timed pulse on a HAL bit pin */
static inline void pulse_output_pin(double *timer_ref, hal_bit_t *pin_ref, float duration_sec)
{
    double d = (double)duration_sec;
    if (d < 0.01) d = 0.01;
    if (d > 5.00) d = 5.00;
    *timer_ref = d;
    *pin_ref   = 1;
}

FUNCTION(_)
{
    int on_cond, off_cond;

    /* ===== Power-on interlock =====
       Recomputed only while the machine is off; once it is on the value is held,
       same as the SET/RESET coil pair in the ladder. */
    if (!machine_on)
        nc_ready = (joystick_neutral && spindle_neutral) ? 1 : 0;

    /* ===== Debounce the contactor feedback =====
       Integrator in samples, like the stock debounce component. Only the rising
       edge is filtered; the fall passes straight through, like the ladder's TON. */
    if (powered_on) {
        const int delay = (powered_on_debounce > 0) ? powered_on_debounce : 0;
        if (db_count < delay)
            db_count++;
        else
            powered_on_db = 1;
    } else {
        db_count      = 0;
        powered_on_db = 0;
    }
    powered_on_dbg = powered_on_db;

    /* ===== On / off pulses =====
       Fired on the rising edge of the condition, which is what a non-retriggerable
       TP timer does in the ladder. */
    on_cond  = (!machine_on && powered_on_db && nc_ready) ? 1 : 0;
    off_cond = ( machine_on && !powered_on) ? 1 : 0;

    if (on_cond && !last_on_cond)
        pulse_output_pin(&t_on, &turn_on, output_pulse_duration);
    if (off_cond && !last_off_cond)
        pulse_output_pin(&t_off, &turn_off, output_pulse_duration);

    last_on_cond  = on_cond;
    last_off_cond = off_cond;

    /* ===== Pulse timers ===== */
    if (t_on > 0.0) {
        t_on -= fperiod;
        if (t_on <= 0.0) { t_on = 0.0; turn_on = 0; }
    }
    if (t_off > 0.0) {
        t_off -= fperiod;
        if (t_off <= 0.0) { t_off = 0.0; turn_off = 0; }
    }
}
