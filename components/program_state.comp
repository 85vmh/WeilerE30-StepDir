component program_state "Readable program state machine: Running / Paused (SB/NoSB) with motion-type based STEP vs feed-hold toggle";

/* ===== Inputs ===== */
pin in  bit   programLoaded;        /* TRUE when a program is loaded */
pin in  bit   cycleStart;           /* user green button (edge: rising) */
pin in  bit   cycleAbort;           /* user red button (edge: rising) */
pin in  bit   singleBlock;          /* SB switch (level) */
pin in  bit   programIdle;          /* halui.program.is-idle */
pin in  bit   programPaused;        /* halui.program.is-paused */
pin in  bit   programRunning;       /* halui.program.is-running */

/* motion.motion-type: 0 = standstill ; nonzero = moving (rapid/feed/arc/...) */
pin in  s32   motionType;

/* Pulse duration (seconds; 0.1 = 100ms) for all command pulses */
pin in  float outputPulseDuration = 0.10;

/* ===== Outputs (commands) ===== */
pin out bit   startProgram;         /* -> halui.program.run    (pulse) */
pin out bit   pauseProgram;         /* -> halui.program.pause  (pulse) */
pin out bit   resumeProgram;        /* -> halui.program.resume (pulse) */
pin out bit   stepProgram;          /* -> halui.program.step   (pulse) */
pin out bit   stopProgram;          /* -> halui.program.stop   (pulse) */
pin out bit   unloadProgram;        /* spare (not used here) */

/* Feed-hold command (level, persistent) */
pin out bit   feedHoldCmd;          /* -> motion.feed-inhibit (0=run, 1=hold) */

/* ===== Status pins (stay ON while in that state) ===== */
pin out bit   statusProgramIdle;           /* ON in ST_IDLE */
pin out bit   statusProgramRunning;        /* ON in ST_RUNNING */
pin out bit   statusProgramPaused;         /* ON in ST_PAUSED_* */
pin out bit   statusIsSingleBlock;         /* mirror singleBlock input */
pin out bit   statusStepPaused;            /* true in ST_PAUSED_SINGLE_BLOCK iff motionType!=0 */

/* ===== LED (green CycleStart) ===== */
pin out bit   cycleStartLedStatus;         /* RUNNING=ON; PAUSED=blink 500/500; IDLE&loaded=double-blink; else OFF */

/* ===== Debug ===== */
param rw s32  state_dbg;                   /* 0=NOT_LOADED,1=IDLE,2=RUNNING,3=PAUSED_NO_SB,4=PAUSED_SB,5=UNKNOWN */
param rw bit  postStartPausePending_dbg;   /* armed pause after Start in SB */
param rw s32  last_action_dbg;             /* 1=start,2=pause,3=resume,4=step,5=stop,7=hold_on,8=hold_off */

/* ===== Function ===== */
function _;
license "GPLv2";
author  "vasi mihalca";

;;
#include <stdbool.h>
#include "rtapi.h"
#include "hal.h"

/* ===== Internal states (explicit, verbose names) ===== */
enum {
    ST_NOT_LOADED             = 0,
    ST_IDLE                   = 1,
    ST_RUNNING                = 2,
    ST_PAUSED_NO_SINGLE_BLOCK = 3,
    ST_PAUSED_SINGLE_BLOCK    = 4,
    ST_UNKNOWN                = 5
};

/* ===== LED modes ===== */
enum {
    LED_OFF                   = 0,
    LED_IDLE_LOADED_DBLINK    = 1,  /* 100ms ON,100ms OFF,100ms ON,700ms OFF */
    LED_PAUSED_BLINK          = 2,  /* 500ms ON / 500ms OFF */
    LED_RUNNING_ON            = 3
};

/* ===== Edge memories & latches ===== */
static bool prevCycleStartLevel        = false;
static bool prevCycleAbortLevel        = false;
static bool prevSingleBlockLevel       = false;

static bool postStartPausePending      = false;   /* after Start with SB=ON, pause when RUNNING appears */
static bool feedHoldLatched            = false;   /* mirror of the feedHoldCmd we drive */
static bool pendingUnloadAfterStop     = false;   /* after Stop: when we see IDLE, pulse Unload once */
static bool firstStepAfterEnterSB      = false;   /* first GREEN in ST_PAUSED_SINGLE_BLOCK must STEP */

static int  prevState                  = ST_UNKNOWN;

/* ===== Pulse timers (seconds) ===== */
static double t_start   = 0.0;
static double t_pause   = 0.0;
static double t_resume  = 0.0;
static double t_step    = 0.0;
static double t_stop    = 0.0;
static double t_unload  = 0.0;

/* ===== LED state ===== */
static int    led_mode       = LED_OFF;
static int    led_mode_prev  = LED_OFF;
static double led_timer      = 0.0;

/* Helper: start a timed pulse on a HAL bit pin */
static inline void pulse_output_pin(double *timer_ref, hal_bit_t *pin_ref, float duration_sec)
{
    double d = (double)duration_sec;
    if (d < 0.01) d = 0.01;
    if (d > 5.00) d = 5.00;
    *timer_ref = d;
    *pin_ref   = 1;
}

FUNCTION(_)
{
    /* ===== Decode explicit state from feedback + SB ===== */
    int state = ST_UNKNOWN;

    if (!programLoaded) {
        state = ST_NOT_LOADED;
    } else if (programIdle) {
        state = ST_IDLE;
    } else if (programRunning) {
        state = ST_RUNNING;
    } else if (programPaused) {
        if (singleBlock) {
            state = ST_PAUSED_SINGLE_BLOCK;
        } else {
            state = ST_PAUSED_NO_SINGLE_BLOCK;
        }
    } else {
        state = ST_UNKNOWN;
    }

    state_dbg = state;

    /* Arm „first step” când INTRĂM în ST_PAUSED_SINGLE_BLOCK */
    if ((state == ST_PAUSED_SINGLE_BLOCK) && (prevState != ST_PAUSED_SINGLE_BLOCK)) {
        firstStepAfterEnterSB = true;
    }
    /* Dacă ieșim din starea SB-paused, resetăm armarea (nu o cărăm în alte stări) */
    if (state != ST_PAUSED_SINGLE_BLOCK) {
        firstStepAfterEnterSB = false;
    }

    /* ===== Status pins ===== */
    statusProgramIdle       = (state == ST_IDLE);
    statusProgramRunning    = (state == ST_RUNNING);
    statusProgramPaused     = (state == ST_PAUSED_NO_SINGLE_BLOCK) || (state == ST_PAUSED_SINGLE_BLOCK);
    statusIsSingleBlock     = singleBlock;

    /* statusStepPaused: setat din interiorul stării SB-paused; default false */
    statusStepPaused        = false;
    if (state == ST_PAUSED_SINGLE_BLOCK) {
        /* „pauză în cadrul unui pas” = motionType != 0 (când togglim feed-hold) */
        statusStepPaused    = (motionType != 0);
    }

    /* ===== Edge detection (rising edges) ===== */
    bool cycleStartLevel    = cycleStart;
    bool cycleAbortLevel    = cycleAbort;
    bool singleBlockLevel   = singleBlock;

    bool cycleStartEdge     = ( cycleStartLevel  && !prevCycleStartLevel );
    bool cycleAbortEdge     = ( cycleAbortLevel  && !prevCycleAbortLevel );
    bool singleBlockRise    = ( singleBlockLevel && !prevSingleBlockLevel );
    bool singleBlockFall    = ( !singleBlockLevel && prevSingleBlockLevel );

    /* ===== Housekeeping on SB transitions ===== */

    /* SB 0->1 while RUNNING: pause once to enter PausedWithSingleBlock */
    if (singleBlockRise && (state == ST_RUNNING)) {
        pulse_output_pin(&t_pause, &pauseProgram, outputPulseDuration);
        last_action_dbg = 2;

        if (feedHoldLatched) {
            feedHoldCmd     = 0;
            feedHoldLatched = false;
            last_action_dbg = 8;
        }
    }

    /* SB 1->0: release feed-hold if active; don't auto-resume; clear pending */
    if (singleBlockFall) {
        if (feedHoldLatched) {
            feedHoldCmd     = 0;
            feedHoldLatched = false;
            last_action_dbg = 8;
        }
        postStartPausePending = false;
    }

    /* If we armed "pause after Start in SB", consume it when RUNNING appears */
    if (postStartPausePending && singleBlockLevel && (state == ST_RUNNING)) {
        pulse_output_pin(&t_pause, &pauseProgram, outputPulseDuration);
        last_action_dbg       = 2;
        postStartPausePending = false;
    }

    postStartPausePending_dbg = postStartPausePending;

    /* ===== Auto-unload after Stop: when we see IDLE and program is still loaded ===== */
    if (pendingUnloadAfterStop && (state == ST_IDLE) && programLoaded) {
        pulse_output_pin(&t_unload, &unloadProgram, outputPulseDuration);
        last_action_dbg        = 6; /* unload */
        pendingUnloadAfterStop = false;
    }

    /* If program got unloaded by other means, clear the latch */
    if (pendingUnloadAfterStop && !programLoaded) {
        pendingUnloadAfterStop = false;
    }

    /* ===== GREEN (cycleStart) behavior ===== */
    if (cycleStartEdge) {

        switch (state) {

            case ST_IDLE: {
                /* Start program; if SB=ON, arm a pause once we see RUNNING */
                pulse_output_pin(&t_start, &startProgram, outputPulseDuration);
                last_action_dbg = 1;

                if (singleBlockLevel) {
                    postStartPausePending = true;
                }
            } break;

            case ST_RUNNING: {
                if (!singleBlockLevel) {
                    /* No SB: Pause -> go to PausedNoSingleBlock */
                    pulse_output_pin(&t_pause, &pauseProgram, outputPulseDuration);
                    last_action_dbg = 2;
                } else {
                    /* SB=ON while still RUNNING (rare):
                       motionType != 0 => toggle feed-hold
                       motionType == 0 => step (ensure hold is off) */
                    if (motionType != 0) {
                        if (!feedHoldLatched) {
                            feedHoldCmd     = 1;
                            feedHoldLatched = true;
                            last_action_dbg = 7;
                        } else {
                            feedHoldCmd     = 0;
                            feedHoldLatched = false;
                            last_action_dbg = 8;
                        }
                    } else {
                        if (feedHoldLatched) {
                            feedHoldCmd     = 0;
                            feedHoldLatched = false;
                            last_action_dbg = 8;
                        }
                        pulse_output_pin(&t_step, &stepProgram, outputPulseDuration);
                        last_action_dbg = 4;
                    }
                }
            } break;

            case ST_PAUSED_NO_SINGLE_BLOCK: {
                /* No SB: Resume -> back to RUNNING */
                pulse_output_pin(&t_resume, &resumeProgram, outputPulseDuration);
                last_action_dbg = 3;
            } break;

            case ST_PAUSED_SINGLE_BLOCK: {
                /* Prima apăsare după intrarea în SB-paused: forțează STEP, indiferent de motion */
                if (firstStepAfterEnterSB) {
                    if (feedHoldLatched) {
                        feedHoldCmd     = 0;
                        feedHoldLatched = false;
                        last_action_dbg = 8;
                    }
                    pulse_output_pin(&t_step, &stepProgram, outputPulseDuration);
                    last_action_dbg        = 4;
                    firstStepAfterEnterSB  = false;
                    break;
                }

                /* După prima apăsare: logica standard SB
                   - motionType == 0  : STEP next block (ensure hold off)
                   - motionType != 0  : toggle feed-hold (persistent) */
                if (motionType != 0) {
                    if (!feedHoldLatched) {
                        feedHoldCmd     = 1;
                        feedHoldLatched = true;
                        last_action_dbg = 7;
                    } else {
                        feedHoldCmd     = 0;
                        feedHoldLatched = false;
                        last_action_dbg = 8;
                    }
                } else {
                    if (feedHoldLatched) {
                        feedHoldCmd     = 0;
                        feedHoldLatched = false;
                        last_action_dbg = 8;
                    }
                    pulse_output_pin(&t_step, &stepProgram, outputPulseDuration);
                    last_action_dbg = 4;
                }
            } break;

            case ST_NOT_LOADED:
            case ST_UNKNOWN:
            default: {
                /* ignore */
            } break;
        }
    }

    /* ===== RED (cycleAbort) behavior: stop from ANY state ===== */
    if (cycleAbortEdge) {
        pulse_output_pin(&t_stop, &stopProgram, outputPulseDuration);
        last_action_dbg       = 5;

        /* clear latches and pending; feedback will drive us back to IDLE */
        postStartPausePending = false;

        if (feedHoldLatched) {
            feedHoldCmd     = 0;
            feedHoldLatched = false;
            last_action_dbg = 8;
        }

        /* arm auto-unload: when we see IDLE, emit unload once */
        pendingUnloadAfterStop = true;

        /* dacă plecăm cu Stop din SB-paused, nu păstrăm „first step” armat */
        firstStepAfterEnterSB = false;
    }

    /* ===== LED state machine (CycleStart LED) ===== */
    /* Choose mode from current state */
    if (state == ST_PAUSED_NO_SINGLE_BLOCK || state == ST_PAUSED_SINGLE_BLOCK) {
        led_mode = LED_PAUSED_BLINK;
    } else if (state == ST_RUNNING) {
        led_mode = LED_RUNNING_ON;
    } else if (state == ST_IDLE && programLoaded) {
        led_mode = LED_IDLE_LOADED_DBLINK;
    } else {
        led_mode = LED_OFF;
    }

    /* Reset LED timer on mode change */
    if (led_mode != led_mode_prev) {
        led_timer     = 0.0;
        led_mode_prev = led_mode;
    }

    /* Advance timer (base period 1.0s) */
    double dt = fperiod;

    led_timer += dt;
    if (led_timer >= 1.0) {
        led_timer -= 1.0;
        if (led_timer < 0.0) {
            led_timer = 0.0;
        }
    }

    /* Apply LED pattern */
    switch (led_mode) {
        case LED_OFF: {
            cycleStartLedStatus = 0;
        } break;

        case LED_RUNNING_ON: {
            cycleStartLedStatus = 1;
        } break;

        case LED_PAUSED_BLINK: {
            /* 500ms ON / 500ms OFF */
            cycleStartLedStatus = (led_timer < 0.5) ? 1 : 0;
        } break;

        case LED_IDLE_LOADED_DBLINK: {
            /* 0–0.1 ON, 0.1–0.2 OFF, 0.2–0.3 ON, 0.3–1.0 OFF */
            if ((led_timer < 0.1) || (led_timer >= 0.2 && led_timer < 0.3)) {
                cycleStartLedStatus = 1;
            } else {
                cycleStartLedStatus = 0;
            }
        } break;

        default: {
            cycleStartLedStatus = 0;
        } break;
    }

    /* ===== Update pulse timers ===== */
    if (t_start  > 0.0) {
        t_start -= dt;
        if (t_start <= 0.0) { t_start = 0.0; startProgram = 0; }
    }
    if (t_pause  > 0.0) {
        t_pause -= dt;
        if (t_pause <= 0.0) { t_pause = 0.0; pauseProgram = 0; }
    }
    if (t_resume > 0.0) {
        t_resume -= dt;
        if (t_resume <= 0.0) { t_resume = 0.0; resumeProgram = 0; }
    }
    if (t_step   > 0.0) {
        t_step -= dt;
        if (t_step <= 0.0) { t_step = 0.0; stepProgram = 0; }
    }
    if (t_stop   > 0.0) {
        t_stop -= dt;
        if (t_stop <= 0.0) { t_stop = 0.0; stopProgram = 0; }
    }
    if (t_unload > 0.0) {
        t_unload -= dt;
        if (t_unload <= 0.0) { t_unload = 0.0; unloadProgram = 0; }
    }

    /* ===== Latch inputs & state for next cycle ===== */
    prevCycleStartLevel  = cycleStartLevel;
    prevCycleAbortLevel  = cycleAbortLevel;
    prevSingleBlockLevel = singleBlockLevel;
    prevState            = state;
}
