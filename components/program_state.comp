component program_state "Program CycleStart/CycleAbort state machine with Single-Block, feed-hold toggle, status pins, and CycleStart LED";

/* ===== Inputs ===== */
pin in  bit   programLoaded           "TRUE when a program is loaded";
pin in  bit   cycleStart              "Cycle Start / Step / Pause / Resume (edge-triggered)";
pin in  bit   cycleAbort              "Cycle Abort / Stop (edge-triggered)";
pin in  bit   singleBlock             "Single-block switch (level)";
pin in  bit   programIdle             "halui.program.is-idle";
pin in  bit   programPaused           "halui.program.is-paused";
pin in  bit   programRunning          "halui.program.is-running";

/* Motion velocity to decide 'moving' (mm/s) */
pin in  float currentVelocity         "Link to motion.current-vel (mm/s)";
param rw float movingHigh = 0.05      "mm/s: 'moving' becomes TRUE above this";
param rw float movingLow  = 0.02      "mm/s: 'moving' becomes FALSE below this";

/* Pulse duration for all outputs: seconds (0.1 = 100ms) */
pin in  float outputPulseDuration = 0.10 "Seconds for OUT pulses (0.1 = 100ms)";

/* ===== Outputs (connect to halui/motion pins) ===== */
pin out bit   startProgram            "-> halui.program.run";
pin out bit   pauseProgram            "-> halui.program.pause";
pin out bit   resumeProgram           "-> halui.program.resume";
pin out bit   stepProgram             "-> halui.program.step";
pin out bit   stopProgram             "-> halui.program.stop";
pin out bit   unloadProgram           "User-mapped: unload/clear program";

pin out bit   feedHoldCmd             "-> motion.feed-inhibit (0=run, 1=hold)";

/* ===== Status Outputs (for UI) ===== */
pin out bit   statusProgramIdle       "ON while state = IDLE (and programLoaded=1)";
pin out bit   statusProgramRunning    "ON while state = RUNNING";
pin out bit   statusProgramPaused     "ON while state = PAUSED";
pin out bit   statusIsSingleBlock     "Mirror of singleBlock input";
pin out bit   statusStepPaused        "ON when waiting for STEP: singleBlock=1 && PAUSED";

/* ===== Cycle Start LED ===== */
pin out bit   cycleStartLedStatus     "Green button LED status (pattern by state)";

/* ===== Debug ===== */
param rw s32  state_dbg               "0=NOT_LOADED,1=IDLE,2=RUNNING,3=PAUSED,4=UNKNOWN";
param rw bit  postStartPausePending_dbg;
param rw s32  last_action_dbg         "1=start,2=pause,3=resume,4=step,5=stop,6=unload,7=hold_on,8=hold_off";
param rw bit  moving_dbg;
param rw bit  feedHold_latched_dbg;

/* ===== Function ===== */
function _;
license "GPLv2";
author  "vasi mihalca";

;;
#include <math.h>
#include <stdbool.h>
#include "rtapi.h"
#include "hal.h"

/* ----- External-state decoding ----- */
enum {
    ST_NOT_LOADED = 0,
    ST_IDLE       = 1,
    ST_RUNNING    = 2,
    ST_PAUSED     = 3,
    ST_UNKNOWN    = 4
};

/* ----- LED mode ----- */
enum {
    LED_OFF = 0,
    LED_IDLE_LOADED_DBLINK = 1,  /* 100 on,100 off,100 on,700 off */
    LED_PAUSED_BLINK = 2,        /* 500 on / 500 off */
    LED_RUNNING_ON = 3
};

/* ----- Edge detect memories ----- */
static bool prev_green = false;
static bool prev_red   = false;
static bool prev_singleBlock = false;

/* ----- Single-block helper ----- */
static bool postStartPausePending = false;

/* ----- Internal feed-hold latch (mirrors what we drive on feedHoldCmd) ----- */
static bool feedHold_latched = false;

/* ----- Pulse timers (seconds) ----- */
static double t_start  = 0.0;
static double t_pause  = 0.0;
static double t_resume = 0.0;
static double t_step   = 0.0;
static double t_stop   = 0.0;
static double t_unload = 0.0;

/* ----- Moving hysteresis flag ----- */
static bool moving_flag = false;

/* ----- LED timers/state ----- */
static int   led_mode      = LED_OFF;
static int   led_mode_prev = LED_OFF;
static double led_timer    = 0.0;

/* ----- Helper: start a timed pulse on a HAL bit pin ----- */
static inline void start_pulse(double *tgt, hal_bit_t *pin, float dur)
{
    double d = (double)dur;
    if (d < 0.01) d = 0.01;
    if (d > 5.00) d = 5.00;
    *tgt = d;
    *pin = 1;
}

FUNCTION(_)
{
    /* === Derive state from feedback === */
    int st;
    if (!programLoaded) {
        st = ST_NOT_LOADED;
    } else if (programIdle) {
        st = ST_IDLE;
    } else if (programRunning) {
        st = ST_RUNNING;
    } else if (programPaused) {
        st = ST_PAUSED;
    } else {
        st = ST_UNKNOWN;
    }
    state_dbg = st;

    /* --- Status mirrors --- */
    statusProgramIdle    = (st == ST_IDLE);
    statusProgramRunning = (st == ST_RUNNING);
    statusProgramPaused  = (st == ST_PAUSED);
    statusIsSingleBlock  = singleBlock;
    statusStepPaused     = (singleBlock && (st == ST_PAUSED));

    /* === Moving hysteresis on currentVelocity === */
 moving_flag && currentVelocity > movingoving_flag = true;
    if ( moving_flag && currentVelocity < movingoving_flag = false;
    moving_dbg = moving_flag;

    /* === Housekeeping: drop feed-hold when not applicable === */
    if (!singleBlock && feedHold_latched) {
        feedHoldCmd = 0;
        feedHold_latched = false;
        last_action_dbg = 8; /* hold_off */
    }
    if (st == ST_IDLE || st == ST_NOT_LOADED || st == ST_UNKNOWN) {
        if (feedHold_latched) {
            feedHoldCmd = 0;
            feedHold_latched = false;
            last_action_dbg = 8; /* hold_off */
        }
    }

    feedHold_latched_dbg = feedHold_latched;

    /* === Edge detect === */
    bool g_now = cycleStart;
    bool r_now = cycleAbort;
    bool g_edge = (g_now && !prev_green);
    bool r_edge = (r_now && !prev_red);

    /* === SingleBlock edge === */
    bool sb_now = singleBlock;
    bool sb_rise = (sb_now && !prev_singleBlock);
    bool sb_fall = (!sb_now && prev_singleBlock);

    /* SB 0->1: if program is running, inject one Pause (enter S_PAUSED) */
    if (sb_rise) {
        postStartPausePending = false; /* reset any stale pending */
        if (st == ST_RUNNING) {
            start_pulse(&t_pause, &pauseProgram, outputPulseDuration);
            last_action_dbg = 2; /* pause */
        }
        /* if hold was ON earlier (shouldn't), we keep it OFF on mode enter */
        if (feedHold_latched) {
            feedHoldCmd = 0;
            feedHold_latched = false;
            last_action_dbg = 8;
        }
    }

    /* SB 1->0: release hold and cancel pending; do not auto-resume */
    if (sb_fall) {
        if (feedHold_latched) {
            feedHoldCmd = 0;
            feedHold_latched = false;
            last_action_dbg = 8; /* hold_off */
        }
        postStartPausePending = false;
    }

    /* === Consume postStartPausePending at actual RUNNING (from Start in SB) === */
    if (postStartPausePending && sb_now && (st == ST_RUNNING)) {
        start_pulse(&t_pause, &pauseProgram, outputPulseDuration);
        last_action_dbg = 2; /* pause */
        postStartPausePending = false;
    }
    postStartPausePending_dbg = postStartPausePending;

    /* === GREEN button behavior === */
    if (g_edge) {
        switch (st) {
            case ST_IDLE:
                /* Start program */
                start_pulse(&t_start, &startProgram, outputPulseDuration);
                last_action_dbg = 1; /* start */
                if (sb_now) {
                    /* Arm one-shot pause to fire when we enter RUNNING */
                    postStartPausePending = true;
                }
                break;

            case ST_RUNNING:
                if (sb_now) {
                    /* Toggle feed-hold while moving in a long STEP */
                    if (!feedHold_latched && moving_flag) {
                        feedHoldCmd = 1;          /* HOLD ON */
                        feedHold_latched = true;
                        last_action_dbg = 7;      /* hold_on */
                    } else if (feedHold_latched) {
                        feedHoldCmd = 0;          /* HOLD OFF (resume same block) */
                        feedHold_latched = false;
                        last_action_dbg = 8;      /* hold_off */
                    } else {
                        /* Not moving and no hold -> about to go PAUSED; do nothing */
                    }
                } else {
                    /* Normal: Pause */
                    start_pulse(&t_pause, &pauseProgram, outputPulseDuration);
                    last_action_dbg = 2; /* pause */
                }
                break;

            case ST_PAUSED:
                if (sb_now) {
                    if (feedHold_latched) {
                        /* Ensure hold released before stepping */
                        feedHoldCmd = 0;
                        feedHold_latched = false;
                        last_action_dbg = 8; /* hold_off */
                    } else {
                        /* Single-block: one step per press */
                        start_pulse(&t_step, &stepProgram, outputPulseDuration);
                        last_action_dbg = 4; /* step */
                    }
                } else {
                    /* Normal: resume */
                    start_pulse(&t_resume, &resumeProgram, outputPulseDuration);
                    last_action_dbg = 3; /* resume */
                }
                break;

            default:
                /* NOT_LOADED / UNKNOWN -> ignore */
                break;
        }
    }

    /* === RED button behavior === */
    if (r_edge) {
        if (st == ST_RUNNING || st == ST_PAUSED) {
            start_pulse(&t_stop, &stopProgram, outputPulseDuration);
            last_action_dbg = 5; /* stop */
            postStartPausePending = false;
            /* Always drop hold on stop */
            if (feedHold_latched) {
                feedHoldCmd = 0;
                feedHold_latched = false;
                last_action_dbg = 8;
            }
        } else if (st == ST_IDLE && programLoaded) {
            start_pulse(&t_unload, &unloadProgram, outputPulseDuration);
            last_action_dbg = 6; /* unload */
        }
    }

    /* === Update pulse timers === */
    double dt = fperiod; /* seconds per servo cycle */

    if (t_start  > 0.0) { t_start  -= dt; if (t_start  <= 0.0) { t_start  = 0.0; startProgram  = 0; } }
    if (t_pause  > 0.0) { t_pause  -= dt; if (t_pause  <= 0.0) { t_pause  = 0.0; pauseProgram  = 0; } }
    if (t_resume > 0.0) { t_resume -= dt; if (t_resume <= 0.0) { t_resume = 0.0; resumeProgram = 0; } }
    if (t_step   > 0.0) { t_step   -= dt; if (t_step   <= 0.0) { t_step   = 0.0; stepProgram   = 0; } }
    if (t_stop   > 0.0) { t_stop   -= dt; if (t_stop   <= 0.0) { t_stop   = 0.0; stopProgram   = 0; } }
    if (t_unload > 0.0) { t_unload -= dt; if (t_unload <= 0.0) { t_unload = 0.0; unloadProgram = 0; } }

    /* === Cycle Start LED state machine === */
    /* Choose LED mode by current state */
    if (st == ST_PAUSED) {
        led_mode = LED_PAUSED_BLINK;
    } else if (st == ST_RUNNING) {
        led_mode = LED_RUNNING_ON;
    } else if (st == ST_IDLE && programLoaded) {
        led_mode = LED_IDLE_LOADED_DBLINK;
    } else {
        led_mode = LED_OFF;
    }

    /* Reset LED timer on mode change */
    if (led_mode != led_mode_prev) {
        led_timer = 0.0;
        led_mode_prev = led_mode;
    }

    /* Advance timer */
    led_timer += dt;
    if (led_timer >= 1.0) {
        /* All patterns cycle at 1.0s base period */
        led_timer -= 1.0;
        if (led_timer < 0.0) led_timer = 0.0;
    }

    /* Apply pattern */
    switch (led_mode) {
        case LED_OFF:
            cycleStartLedStatus = 0;
            break;
        case LED_RUNNING_ON:
            cycleStartLedStatus = 1;
            break;
        case LED_PAUSED_BLINK:
            /* 500ms ON / 500ms OFF */
            cycleStartLedStatus = (led_timer < 0.5) ? 1 : 0;
            break;
        case LED_IDLE_LOADED_DBLINK:
            /* 0-0.1 ON, 0.1-0.2 OFF, 0.2-0.3 ON, 0.3-1.0 OFF */
            if ((led_timer < 0.1) || (led_timer >= 0.2 && led_timer < 0.3)) {
                cycleStartLedStatus = 1;
            } else {
                cycleStartLedStatus = 0;
            }
            break;
        default:
            cycleStartLedStatus = 0;
            break;
    }

    /* === Latch edges === */
    prev_green       = g_now;
    prev_red         = r_now;
    prev_singleBlock = sb_now;
}
