component program_state "Program CycleStart/Abort SM with Single-Block, feed-hold toggle (motion-type), status pins, LED, and auto-unload after Stop";

/* ===== Inputs ===== */
pin in  bit   programLoaded;
pin in  bit   cycleStart;
pin in  bit   cycleAbort;
pin in  bit   singleBlock;
pin in  bit   programIdle;
pin in  bit   programPaused;
pin in  bit   programRunning;

/* Motion-type: 0=standstill, nonzero=rapid/feed/arc/etc */
pin in  s32   motionType;

/* Pulse duration (seconds; 0.1 = 100 ms) */
pin in  float outputPulseDuration = 0.10;

/* ===== Outputs (halui/motion) ===== */
pin out bit   startProgram;
pin out bit   pauseProgram;
pin out bit   resumeProgram;
pin out bit   stepProgram;
pin out bit   stopProgram;
pin out bit   unloadProgram;

pin out bit   feedHoldCmd;        /* -> motion.feed-inhibit (0=run, 1=hold) */

/* ===== Status (UI) ===== */
pin out bit   statusProgramIdle;
pin out bit   statusProgramRunning;
pin out bit   statusProgramPaused;
pin out bit   statusIsSingleBlock;
pin out bit   statusStepPaused;
pin out bit   cycleStartLedStatus;

/* ===== Debug ===== */
param rw s32  state_dbg;              /* 0=NOT_LOADED,1=IDLE,2=RUNNING,3=PAUSED,4=UNKNOWN */
param rw bit  postStartPausePending_dbg;
param rw s32  last_action_dbg;        /* 1=start,2=pause,3=resume,4=step,5=stop,6=unload,7=hold_on,8=hold_off */
param rw bit  feedHold_latched_dbg;

/* ===== Function ===== */
function _;
license "GPLv2";
author  "vasi mihalca";

;;
#include <stdbool.h>
#include "rtapi.h"
#include "hal.h"

/* ----- States ----- */
enum { ST_NOT_LOADED=0, ST_IDLE=1, ST_RUNNING=2, ST_PAUSED=3, ST_UNKNOWN=4 };

/* ----- LED modes ----- */
enum { LED_OFF=0, LED_IDLE_LOADED_DBLINK=1, LED_PAUSED_BLINK=2, LED_RUNNING_ON=3 };

/* ----- Edges & latches ----- */
static bool prev_green=false, prev_red=false, prev_singleBlock=false;
static bool postStartPausePending=false;
static bool feedHold_latched=false;
static bool pendingUnloadAfterStop=false;

/* ----- Pulse timers (seconds) ----- */
static double t_start=0.0, t_pause=0.0, t_resume=0.0, t_step=0.0, t_stop=0.0, t_unload=0.0;

/* ----- LED state ----- */
static int led_mode=LED_OFF, led_mode_prev=LED_OFF;
static double led_timer=0.0;

/* Helper: timed pulse */
static inline void start_pulse(double *tgt, hal_bit_t *pin, float dur) {
    double d = (double)dur;
    if (d < 0.01) d = 0.01;
    if (d > 5.00) d = 5.00;
    *tgt = d; *pin = 1;
}

FUNCTION(_)
{
    /* === Decode external state === */
    int st;
    if (!programLoaded)        st = ST_NOT_LOADED;
    else if (programIdle)      st = ST_IDLE;
    else if (programRunning)   st = ST_RUNNING;
    else if (programPaused)    st = ST_PAUSED;
    else                       st = ST_UNKNOWN;
    state_dbg = st;

    /* Status pins */
    statusProgramIdle    = (st == ST_IDLE);
    statusProgramRunning = (st == ST_RUNNING);
    statusProgramPaused  = (st == ST_PAUSED);
    statusIsSingleBlock  = singleBlock;
    statusStepPaused     = (singleBlock && (st == ST_PAUSED));

    /* ------- Feed-hold housekeeping ------- */
    /* 1) La ieșire din SB sau în stări nevalide, eliberează hold */
    if (!singleBlock && feedHold_latched) {
        feedHoldCmd = 0; feedHold_latched = false; last_action_dbg = 8;
    }
    if (st == ST_IDLE || st == ST_NOT_LOADED || st == ST_UNKNOWN) {
        if (feedHold_latched) { feedHoldCmd = 0; feedHold_latched = false; last_action_dbg = 8; }
    }
    /* IMPORTANT: NU mai eliberăm hold când motionType == 0.
       Vrei ca feedHoldCmd să PERSISTE până îl schimbi tu manual sau ieși din SB / Stop / Idle. */

    feedHold_latched_dbg = feedHold_latched;

    /* Edges */
    bool g_now = cycleStart, r_now = cycleAbort, sb_now = singleBlock;
    bool g_edge = (g_now && !prev_green);
    bool r_edge = (r_now && !prev_red);
    bool sb_rise = (sb_now && !prev_singleBlock);
    bool sb_fall = (!sb_now && prev_singleBlock);

    /* SB 0->1: dacă rulează, pauză automată (intră în PAUSED pentru STEP) */
    if (sb_rise) {
        postStartPausePending = false;
        if (st == ST_RUNNING) { start_pulse(&t_pause, &pauseProgram, outputPulseDuration); last_action_dbg = 2; }
        /* asigură hold OFF la intrare în SB */
        if (feedHold_latched) { feedHoldCmd = 0; feedHold_latched = false; last_action_dbg = 8; }
    }

    /* SB 1->0: release hold, anulează pending; NU auto-resume */
    if (sb_fall) {
        if (feedHold_latched) { feedHoldCmd = 0; feedHold_latched = false; last_action_dbg = 8; }
        postStartPausePending = false;
    }

    /* postStartPausePending: consumă când intrăm efectiv în RUNNING (după Start) */
    if (postStartPausePending && sb_now && (st == ST_RUNNING)) {
        start_pulse(&t_pause, &pauseProgram, outputPulseDuration); last_action_dbg = 2;
        postStartPausePending = false;
    }
    postStartPausePending_dbg = postStartPausePending;

    /* GREEN behavior */
    if (g_edge) {
        if (sb_now) {
            if (st == ST_IDLE) {
                start_pulse(&t_start, &startProgram, outputPulseDuration); last_action_dbg = 1;
                postStartPausePending = true;
            } else {
                if (motionType != 0) {
                    /* În mișcare: toggle feed-hold (PERSISTENT) */
                    if (!feedHold_latched) {
                        feedHoldCmd = 1; feedHold_latched = true; last_action_dbg = 7;  /* HOLD ON */
                    } else {
                        feedHoldCmd = 0; feedHold_latched = false; last_action_dbg = 8; /* HOLD OFF */
                    }
                } else {
                    /* Standstill între blocuri: STEP (și ne asigurăm că hold e OFF) */
                    if (feedHold_latched) { feedHoldCmd = 0; feedHold_latched = false; last_action_dbg = 8; }
                    start_pulse(&t_step, &stepProgram, outputPulseDuration); last_action_dbg = 4;
                }
            }
        } else {
            /* SB OFF: logică standard */
            switch (st) {
                case ST_IDLE:    start_pulse(&t_start,  &startProgram,  outputPulseDuration); last_action_dbg = 1; break;
                case ST_RUNNING: start_pulse(&t_pause,  &pauseProgram,  outputPulseDuration); last_action_dbg = 2; break;
                case ST_PAUSED:  start_pulse(&t_resume, &resumeProgram, outputPulseDuration); last_action_dbg = 3; break;
                default: break;
            }
        }
    }

    /* RED behavior */
    if (r_edge) {
        if (st == ST_RUNNING || st == ST_PAUSED) {
            start_pulse(&t_stop, &stopProgram, outputPulseDuration); last_action_dbg = 5;
            postStartPausePending = false;
            if (feedHold_latched) { feedHoldCmd = 0; feedHold_latched = false; last_action_dbg = 8; }
            pendingUnloadAfterStop = true;   /* => când devine IDLE, pulsez Unload */
        } else if (st == ST_IDLE && programLoaded) {
            start_pulse(&t_unload, &unloadProgram, outputPulseDuration); last_action_dbg = 6;
            pendingUnloadAfterStop = false;
        }
    }

    /* Auto-unload după Stop: când devine IDLE */
    if (pendingUnloadAfterStop && (st == ST_IDLE) && programLoaded) {
        start_pulse(&t_unload, &unloadProgram, outputPulseDuration); last_action_dbg = 6;
        pendingUnloadAfterStop = false;
    }
    if (pendingUnloadAfterStop && (!programLoaded)) {
        pendingUnloadAfterStop = false;
    }

    /* Timere pulsuri */
    double dt = fperiod;
    if (t_start  > 0.0) { t_start  -= dt; if (t_start  <= 0.0) { t_start  = 0.0; startProgram  = 0; } }
    if (t_pause  > 0.0) { t_pause  -= dt; if (t_pause  <= 0.0) { t_pause  = 0.0; pauseProgram  = 0; } }
    if (t_resume > 0.0) { t_resume -= dt; if (t_resume <= 0.0) { t_resume = 0.0; resumeProgram = 0; } }
    if (t_step   > 0.0) { t_step   -= dt; if (t_step   <= 0.0) { t_step   = 0.0; stepProgram   = 0; } }
    if (t_stop   > 0.0) { t_stop   -= dt; if (t_stop   <= 0.0) { t_stop   = 0.0; stopProgram   = 0; } }
    if (t_unload > 0.0) { t_unload -= dt; if (t_unload <= 0.0) { t_unload = 0.0; unloadProgram = 0; } }

    /* LED pattern by state */
    if (st == ST_PAUSED)                    led_mode = LED_PAUSED_BLINK;
    else if (st == ST_RUNNING)              led_mode = LED_RUNNING_ON;
    else if (st == ST_IDLE && programLoaded)led_mode = LED_IDLE_LOADED_DBLINK;
    else                                    led_mode = LED_OFF;

    if (led_mode != led_mode_prev) { led_timer = 0.0; led_mode_prev = led_mode; }

    led_timer += dt; if (led_timer >= 1.0) { led_timer -= 1.0; if (led_timer < 0.0) led_timer = 0.0; }

    switch (led_mode) {
        case LED_OFF:                   cycleStartLedStatus = 0; break;
        case LED_RUNNING_ON:           cycleStartLedStatus = 1; break;
        case LED_PAUSED_BLINK:         cycleStartLedStatus = (led_timer < 0.5) ? 1 : 0; break;
        case LED_IDLE_LOADED_DBLINK:   cycleStartLedStatus = ((led_timer < 0.1) || (led_timer >= 0.2 && led_timer < 0.3)) ? 1 : 0; break;
        default:                       cycleStartLedStatus = 0; break;
    }

    /* Latch inputs */
    prev_green       = g_now;
    prev_red         = r_now;
    prev_singleBlock = sb_now;
}
