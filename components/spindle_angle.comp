component spindle_angle "Spindle angle in degrees, derived from a 1:1 encoder referenced to its index pulse";

/* ===== Pins ===== */
pin in  float position        "Encoder position in revolutions (encoder.NN.position)";
pin in  float offset = 0.0    "Mechanical offset in degrees between index pulse and desired zero";
pin in  bit   index-enable    "Connect to the same signal that drives encoder.NN.index-enable";

pin out float angle           "Spindle angle, 0 <= angle < 360";
pin out s32   angle-int       "Spindle angle rounded to whole degrees, 0..359";
pin out s32   revolutions     "Whole revolutions counted since the index pulse";
pin out bit   referenced      "True once an index pulse has been seen (angle is meaningful)";

function _ "Update angle from position";
license "GPLv2";
author  "vasi";

description """
The angle is the fractional part of the encoder position, which is only
meaningful once the encoder counter has been zeroed by its index pulse.
This is the same assumption *orient* makes about its *position* pin.

*referenced* latches high on the falling edge of *index-enable*, i.e. when the
hostmot2 encoder acknowledges the index pulse by clearing the pin.

[source,hal]
----
loadrt spindle_angle names=sp-angle
addf sp-angle servo-thread
setp sp-angle.offset 0
net sp.revs      => sp-angle.position
net spindle-sync => sp-angle.index-enable
----
""";

;;
#include <rtapi_math.h>

static int last_index_enable = 0;

FUNCTION(_)
{
    double revs, frac;

    /* an index pulse clears index-enable: latch that we are referenced */
    if (last_index_enable && !index_enable)
        referenced = 1;
    last_index_enable = index_enable;

    revs = position + offset / 360.0;

    /* floor() keeps the result in [0,1) for negative positions too,
       so reverse rotation gives the correct angle instead of a negative one */
    frac = revs - floor(revs);

    angle = frac * 360.0;
    if (angle >= 360.0)     /* guard against rounding at the wrap point */
        angle = 0.0;

    angle_int = (int)(angle + 0.5);
    if (angle_int >= 360)
        angle_int = 0;

    revolutions = (int)floor(position);
}
