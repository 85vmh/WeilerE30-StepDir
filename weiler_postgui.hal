# These are the the connections made after the UI was launched and custom pins were created
loadrt  weiler_manual_mode
addf    weiler-manual-mode.0     servo-thread


net in.spindle-rev          TeachInLathe.spindle.switch-rev-in
net in.spindle-fwd          TeachInLathe.spindle.switch-fwd-in
net in.spindle-gear1        TeachInLathe.spindle.is-first-gear
net in.chuck-cover          TeachInLathe.spindle.cover-opened
net sp.vel-fb-rpm           TeachInLathe.spindle.actual-rpm

net in.joystick-x-plus      TeachInLathe.joystick.x-plus   
net in.joystick-x-minus     TeachInLathe.joystick.x-minus   
net in.joystick-z-plus      TeachInLathe.joystick.z-plus    
net in.joystick-z-minus     TeachInLathe.joystick.z-minus 
net in.joystick-rapid       TeachInLathe.joystick.rapid
net app.feed-per-rev        TeachInLathe.joystick.feed-per-rev
net app.is-angle-feed       TeachInLathe.joystick.is-angle-feed
net app.jog-speed           TeachInLathe.joystick.jog-speed
net app.program-loaded      TeachInLathe.app-status.program-loaded


# hardcoded parameters
setp                        weiler-manual-mode.0.allowMpgDelay       0.5 # 0.5 second
setp                        weiler-manual-mode.0.startFeedDelay      1   # 1 second
net app.jog-speed           weiler-manual-mode.0.jogRapidSpeed

# input pins
net sp.is-running       =>  weiler-manual-mode.0.spindleOn   => TeachInLathe.spindle.is-on
net sp.angle            =>  TeachInLathe.spindle.orientation
net sp.vel-fb-rpm       =>  weiler-manual-mode.0.spindleRpm
net app.feed-per-rev    =>  weiler-manual-mode.0.feedPerRev
net mw.override-value   =>  halui.feed-override.value   =>  weiler-manual-mode.0.feedOverride

net in.joystick-neutral     weiler-manual-mode.0.joystickNeutral
net in.joystick-x-plus      weiler-manual-mode.0.joystickXPlus   
net in.joystick-x-minus     weiler-manual-mode.0.joystickXMinus  
net in.joystick-z-plus      weiler-manual-mode.0.joystickZPlus    
net in.joystick-z-minus     weiler-manual-mode.0.joystickZMinus
net in.joystick-rapid       weiler-manual-mode.0.joystickRapid
net app.is-angle-feed       weiler-manual-mode.0.angleFeed

# outputs
net mw.out-jog-speed    =>  weiler-manual-mode.0.jogSpeed    =>  halui.axis.jog-speed
net jog-x-neg           <=  weiler-manual-mode.0.jogXMinus
net jog-x-pos           <=  weiler-manual-mode.0.jogXPlus
net jog-z-neg           <=  weiler-manual-mode.0.jogZMinus
net jog-z-pos           <=  weiler-manual-mode.0.jogZPlus
net mw.feeding          =>  weiler-manual-mode.0.feeding     =>  TeachInLathe.joystick.is-feeding     

net mpg.readable-increment  TeachInLathe.handwheels.jog-increment
# Enable MPG's if they are enabled in the UI
net mpg.app-x-enable        TeachInLathe.handwheels.x-enable    =>  and.x-mpg-enable.in0
net mpg.app-z-enable        TeachInLathe.handwheels.z-enable    =>  and.z-mpg-enable.in0

# 
net mpg.jog-allowed         <=  weiler-manual-mode.0.allowMpg
net mpg.jog-allowed         =>  and.x-mpg-enable.in1
net mpg.jog-allowed         =>  and.z-mpg-enable.in1
net mpg.jog-allowed         =>  TeachInLathe.handwheels.allowed

net mpg.x-enable.out        and.x-mpg-enable.out    =>  axis.x.jog-enable   
net mpg.z-enable.out        and.z-mpg-enable.out    =>  axis.z.jog-enable   


net in.cycle-start          TeachInLathe.button.cycle-start
net in.cycle-abort          TeachInLathe.button.cycle-stop

net xmin TeachInLathe.axis-limits.x-min   => ini.x.min_limit
net xmax TeachInLathe.axis-limits.x-max   => ini.x.max_limit
net zmin TeachInLathe.axis-limits.z-min   => ini.z.min_limit
net zmax TeachInLathe.axis-limits.z-max   => ini.z.max_limit

net sp.reset-required       TeachInLathe.spindle.reset-required
net js.reset-required       weiler-manual-mode.0.resetRequired   => TeachInLathe.joystick.reset-required

net app.program-loaded      program-state.0.programLoaded
net out.cycle-start-led     =>  TeachInLathe.app-status.cycle-start-led


# Tool change will be confirmed by cycle start. 

net tool:change     <=  iocontrol.0.tool-change
net tool:change     =>  program-state.0.toolChange  
net tool:change     =>  TeachInLathe.tool-change.change

net tool.changed    <=  program-state.0.toolChanged
net tool.changed    =>  iocontrol.0.tool-changed
net tool:changed    =>  TeachInLathe.tool-change.changed

net tool:number     iocontrol.0.tool-prep-number    =>  TeachInLathe.tool-change.number
net tool:prepare    iocontrol.0.tool-prepare        =>  iocontrol.0.tool-prepared